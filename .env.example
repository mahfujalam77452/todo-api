# Copy this file to .env and fill in the values. Never commit .env.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# true only for local development
DEBUG=true

# Comma separated. Required when DEBUG=false.
ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL connection URL. Leave empty to use the local SQLite fallback.
# Example: postgresql://todo_user:password@localhost:5432/todo_db
# DATABASE_URL=
# Optional: also write logs to a rotating file (the console is always used).
LOG_FILE=logs/app.log
# Optional: use Redis for the cache (and, later, rate limiting). Without it a
# per-process in-memory cache is used. The API keeps working if Redis goes down.
REDIS_URL=redis://localhost:6379/1

# Optional: sign JWTs with a key other than SECRET_KEY (at least 32 characters).
JWT_SIGNING_KEY=

# Reverse proxies between the internet and this app (0 = none). Needed for
# per-IP rate limits to see the real client address; see config/settings.py.
NUM_PROXIES=0