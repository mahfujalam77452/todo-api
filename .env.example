# Copy this file to .env and fill in the values. Never commit .env.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# true only for local development
DEBUG=true

# Comma separated. Required when DEBUG=false.
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: also write logs to a rotating file (the console is always used).
# LOG_FILE=logs/app.log